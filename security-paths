# Security paths: packages whose contracts have an "Untrusted input" section. A pull request that
# touches one gets a security review before the developer signs off. A package joins in the same
# pull request as that contract. One pattern a line, a shell glob that is also a git pathspec.
internal/telnet/*
internal/telnets/*
internal/listener/*
internal/session/*
internal/textio/*
internal/ssh/*
internal/database/*
internal/language/*
internal/bootstrap/*
internal/servicemanager/*
