#!/usr/bin/env bash
# git's credential helper for the loop's clone: the same fresh token, never written to the
# clone's config. Only "get" answers; store and erase are no-ops.
[ "$1" = get ] || exit 0
echo username=x-access-token
echo "password=$(pwsh -NoProfile -File "$HELIOS_AUTOMATION/app-token.ps1")"
